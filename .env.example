# Kopieren nach .env.local und Werte eintragen. Niemals echte Werte hier committen.
# Der site-engine ist öffentlich erreichbar: hier gehört NIE ein Service-Role-Key oder
# ein sonstiges Secret mit Schreibrechten hinein (docs/06-repository-struktur.md).

# --- Milestone 0 (aktiv) ---
# Supabase: Settings > API. Basis-URL OHNE /rest/v1/ am Ende.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Milestone 4 (optional) ---
# Weitere Hosts, die das site-engine selbst bedienen (kommagetrennt, z. B. die Produktions-Vercel-Adresse)
ENGINE_HOSTS=
# Vorschau-Subdomains {slug}.<Basisdomain>; ohne Wert gilt der Pfad /preview/<slug>
PREVIEW_BASE_DOMAIN=

# --- Milestone 5A: Vorschau-Zugang ---
# Beide mindestens 32 Zeichen, zufällig erzeugen (openssl rand -hex 32). Ohne sie bleiben passwortgeschützte Vorschauen geschlossen.
PREVIEW_COOKIE_SECRET=      # signiert die Freischalt-Cookies
REVALIDATE_SECRET=          # gleicher Wert wie im Dashboard; darf ausschließlich die Aktualisierung auslösen

# --- Spätere Milestones (noch nicht verwendet) ---
# M4  RESEND_API_KEY=          # Kontaktformular-Versand; Key darf nur E-Mails senden
